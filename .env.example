# Traffic AI API Configuration
# The external Traffic AI API endpoint
TRAFFIC_AI_API_URL=https://v3-api-job-72802495918.us-east1.run.app

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Optional: Enable debug logging
# DEBUG=true

# Stripe — Server-side keys (required for checkout + webhook signature verification)
# Get from https://dashboard.stripe.com/apikeys (test keys for dev, live keys for production)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe — Price IDs (NEXT_PUBLIC_ so the frontend can build checkout URLs)
# Create products + recurring prices in https://dashboard.stripe.com/products
NEXT_PUBLIC_STRIPE_STARTER_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_STARTER_YEARLY=price_...
NEXT_PUBLIC_STRIPE_GROWTH_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_GROWTH_YEARLY=price_...
NEXT_PUBLIC_STRIPE_PROFESSIONAL_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PROFESSIONAL_YEARLY=price_...

# Credential encryption key (32-byte hex). Used to encrypt stored integration credentials
# (e.g. LinkedIn credentials in platform_integrations.config). Generate once with:
#   openssl rand -hex 32
# If unset, the app falls back to base64 encoding — DO NOT ship to production without this.
ENCRYPTION_KEY=

# Cron Job Secret (used to secure cron endpoints — Vercel cron sends this in the Authorization header)
CRON_SECRET=your_cron_secret_here

# SMTP — outbound chat notification email (nodemailer).
# These are FALLBACKS ONLY: matching rows in app_settings (Settings > Chat Email
# Notifications, category `notifications`) take precedence when set.
# For Gmail / Google Workspace, SMTP_PASSWORD must be an app password
# (myaccount.google.com > Security > App passwords, requires 2-step verification) —
# not the account password. Workspace caps outbound mail at roughly 2,000/day.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
